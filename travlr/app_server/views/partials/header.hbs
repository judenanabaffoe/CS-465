<div id="header">
	<div id="logo">
		<a href="/"><img src="/images/logo.png" alt="{{brand}}" height="100" width="200"></a>
	</div>
	<div id="navigation">
		<ul>
			{{#each nav}}
			<li{{#if current}} class="selected"{{/if}}>
				<a href="{{href}}">{{label}}</a>
			</li>
			{{/each}}
		</ul>
	</div>
</div>
