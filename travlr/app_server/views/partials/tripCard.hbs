<li>
	<a href="/travel"><img src="/images/{{image}}" alt="{{name}}"></a>
	<h2><a href="/travel">{{name}}</a></h2>
	<p>
		<strong>{{length}}</strong> &middot; Starts {{startDisplay}} &middot; {{resort}} &middot; ${{perPerson}} per person
	</p>
	{{#each description}}
	<p>
		{{this}}
	</p>
	{{/each}}
</li>
