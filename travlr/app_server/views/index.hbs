<div id="contents">
	<div id="adbox">
		<img src="/images/{{home.adbox.image}}" alt="{{home.adbox.heading}}">
		<h1>{{home.adbox.heading}}</h1>
		<p>
			{{home.adbox.text}}
		</p>
	</div>
	<div id="main">
		<div class="box">
			<div>
				<div>
					<h3>Latest Blog</h3>
					<ul>
						{{#each blog}}
						<li>
							<h4><a href="/news">{{title}}</a></h4>
							<span>{{date}}</span>
							<p>
								{{summary}}
							</p>
						</li>
						{{/each}}
					</ul>
				</div>
			</div>
		</div>
		<div id="testimonials" class="box">
			<div>
				<div>
					<h3>Testimonials</h3>
					<p>
						&ldquo;{{home.testimonial.quote}}&rdquo; <span>- <a href="/">{{home.testimonial.author}}</a></span>
					</p>
				</div>
			</div>
		</div>
	</div>
	<div id="sidebar">
		{{#each home.tiles}}
		<div class="section">
			<a href="{{href}}"><img src="/images/{{image}}" alt="{{href}}"></a>
		</div>
		{{/each}}
	</div>
</div>
