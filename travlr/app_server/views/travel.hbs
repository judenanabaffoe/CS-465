<div id="contents">
	<div class="box">
		<div>
			<div class="body">
				<h1>Travel</h1>
				<ul id="sites">
					{{#each trips}}
					<li>
						<a href="/travel"><img src="/images/{{image}}" alt="{{name}}"></a>
						<h2><a href="/travel">{{name}}</a></h2>
						<p>
							<strong>{{length}}</strong> &middot; {{resort}} &middot; ${{perPerson}} per person
						</p>
						{{#each description}}
						<p>
							{{this}}
						</p>
						{{/each}}
					</li>
					{{/each}}
				</ul>
			</div>
		</div>
	</div>
</div>
